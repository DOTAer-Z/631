# 故障定位 + 日志标注 集成系统 — 环境变量（631change 6 镜像版）
# 复制为 .env 后再 `docker compose up -d`
# compose 中所有 ${VAR:-default} 都有兜底，.env 可整体留空（除 LLM / 网关 token）

# ─── 主系统数据库 ────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=secret
POSTGRES_DB=fault_diagnosis

# ─── 标注子系统数据库 ───────────────────────────────────────────────────────
ANNOTATE_DB=data_bj
ANNOTATE_USER=data_bj
ANNOTATE_PASSWORD=data_bj

# ─── 标注子系统其它 ─────────────────────────────────────────────────────────
APP_ENV=production
LOG_LEVEL=INFO
MAX_UPLOAD_BYTES=1073741824

# =============================================================================
# 大模型 (LLM) — 主系统与标注子系统共享同一组配置
# 启用条件：ENABLE_LLM=True 且 LLM_BASE_URL / LLM_MODEL / LLM_API_KEY 三项都非空。
# 任一不满足时所有 LLM 功能静默降级到规则逻辑，不报错。
# 示例 A: DashScope  LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1  LLM_MODEL=qwen3-coder-480b-a35b-instruct
# 示例 B: DeepSeek   LLM_BASE_URL=https://api.deepseek.com                           LLM_MODEL=deepseek-chat
# 示例 C: 内网 vLLM  LLM_BASE_URL=http://172.30.4.43:8001/v1  LLM_API_KEY=dummy       LLM_MODEL=dsqwen32b
# =============================================================================
ENABLE_LLM=False
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT=60
LLM_MAX_OUTPUT_TOKENS=1024

# =============================================================================
# 跨子系统 LLM 网关 token（重要）
# 主后端与标注后端通过 INTERNAL_LLM_GATEWAY_TOKEN 校验网关调用（标注 → 主 /api/v1/internal/llm/chat）。
# 【主系统与标注子系统必须填同一个值】；留空时标注侧大模型功能不可用（推荐卡显示「LLM 未配置」）。
# 生成：openssl rand -hex 32
# =============================================================================
INTERNAL_LLM_GATEWAY_TOKEN=

# =============================================================================
# 模型 API 凭据加密 Fernet key
# 用「模型 API 管理」保存/读取加密凭据时必填；留空时核心功能正常，仅该功能报错。
# 一旦库里存过加密行就【不要】再改此值。
# 生成：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# =============================================================================
MODEL_API_ENCRYPTION_KEY=

# ── 跨子系统导入桥（docker/k8s 网络内默认即可，一般无需改）
MAIN_SYSTEM_BACKEND_URL=http://backend:8000/api/v1
ANNOTATE_BACKEND_URL=http://backend-annotate:8000/api/v1
