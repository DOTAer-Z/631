# 集成方案 A — 共用环境变量（主系统 + 标注子系统）
# 复制为 .env 后再 `docker compose up -d --build`
# compose 文件中所有 ${VAR:-default} 都有兜底，.env 也可以完全留空（除 LLM 部分）
# =============================================================================

# ─── 主系统数据库 ────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=secret
POSTGRES_DB=fault_diagnosis

# ─── GPU 训练 Worker ─────────────────────────────────────────────────────────
# 主机上的 Qwen3.5-9B 模型目录；Compose 以只读方式挂载到训练容器。
TRAINING_BASE_MODEL_HOST_PATH=../models/Qwen3.5-9B

# ─── 标注子系统数据库 ───────────────────────────────────────────────────────
ANNOTATE_DB=data_bj
ANNOTATE_USER=data_bj
ANNOTATE_PASSWORD=data_bj

# ─── 标注子系统其它 ─────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
MAX_UPLOAD_BYTES=1073741824

# =============================================================================
# 大模型 (LLM) — 主系统 provider 兼容配置 + 标注子系统内部网关配置
# -----------------------------------------------------------------------------
# 以下 provider 配置仅供主系统后端兼容使用，backend-annotate 不直接消费。
# 启用条件：
#   ENABLE_LLM=True
#   且 LLM_BASE_URL / LLM_MODEL / LLM_API_KEY 三项都非空
# 任一不满足时所有 LLM 功能静默降级，不影响其它接口。
# 协议：OpenAI Chat Completions 兼容（实际请求 {LLM_BASE_URL}/chat/completions）
# -----------------------------------------------------------------------------
# 两个示例供参考，二选一取消注释：
#
# 示例 A：阿里云 DashScope（公网，需有效 API key）
#   ENABLE_LLM=True
#   LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#   LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
#   LLM_MODEL=qwen3-coder-480b-a35b-instruct
#
# 示例 B：内网 vLLM（DeepSeek-Qwen-32B 等本地部署）
#   ENABLE_LLM=True
#   LLM_BASE_URL=http://172.30.4.43:8001/v1
#   LLM_API_KEY=dummy
#   LLM_MODEL=dsqwen32b
# =============================================================================
ENABLE_LLM=True
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=sk-replace-me
LLM_MODEL=deepseek-v4-flash
LLM_TIMEOUT=60
LLM_MAX_OUTPUT_TOKENS=1024
LOG_PARSE_TIMEOUT_SECONDS=60
LOG_PARSE_WORKERS=1

# Shared service-to-service token for the internal LLM gateway.
# Generate independently per environment, for example: openssl rand -hex 32
INTERNAL_LLM_GATEWAY_TOKEN=
LLM_GATEWAY_URL=http://backend:8000/api/v1/internal/llm/chat
LLM_GATEWAY_TIMEOUT_SECONDS=180

# Stable Fernet key for encrypting model API credentials stored in PostgreSQL.
# Generate once; do not rotate or delete it while encrypted rows exist:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MODEL_API_ENCRYPTION_KEY=

# ── 「从主系统导入」跨系统取数（标注子系统 → 主系统 DB1）─────────────────────
# docker 网络内默认即可；一般无需改。未配置/主系统不可达时仅「从主系统导入」失败。
MAIN_SYSTEM_BACKEND_URL=http://backend:8000/api/v1

# ── 「从标注典型案例导入」跨系统取数（主系统 → 标注子系统 DB2）──────────────
# docker 网络内默认即可。未配置/标注子系统不可达时仅该导入失败，不影响其它功能。
ANNOTATE_BACKEND_URL=http://backend-annotate:8000/api/v1
