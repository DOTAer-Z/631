# App environment
APP_ENV=development
LOG_LEVEL=INFO

# Database
POSTGRES_DB=data_bj
POSTGRES_USER=data_bj
POSTGRES_PASSWORD=data_bj
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://data_bj:data_bj@postgres:5432/data_bj

# Storage
STORAGE_ROOT=/data/storage
MAX_UPLOAD_BYTES=1073741824

# Service ports
BACKEND_PORT=8000
FRONTEND_PORT=5173

# Frontend -> backend URL (used by Vite)
VITE_API_BASE_URL=http://localhost:8000/api/v1

# LLM (OpenAI-compatible) — powers adaptive timestamp parsing + fault recommendation.
# Leave LLM_API_KEY blank to disable (features degrade gracefully). DeepSeek example:
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_SECONDS=30
